<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Network: outbound connections to Anthropic, OpenAI, Gemini APIs and local Ollama -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow unsigned executable memory (needed for JIT in some AI inference paths) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation (needed for loading Ollama and external tools) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
