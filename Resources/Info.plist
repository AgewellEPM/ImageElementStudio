<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle identification -->
    <key>CFBundleIdentifier</key>
    <string>com.imageelementstudio.app</string>

    <key>CFBundleName</key>
    <string>Image Element Studio</string>

    <key>CFBundleDisplayName</key>
    <string>Image Element Studio</string>

    <key>CFBundleExecutable</key>
    <string>ImageElementStudio</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Version info: these placeholders are replaced by the build scripts.
         $(MARKETING_VERSION) -> user-facing version (e.g. 1.0.0)
         $(CURRENT_PROJECT_VERSION) -> internal build number (e.g. 1) -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- Platform requirements: matches Package.swift .macOS(.v14) -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Display -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- App Transport Security: allow connections to AI API endpoints.
         The app communicates with Anthropic and OpenAI APIs over HTTPS.
         This configuration ensures TLS 1.2+ is enforced (the default)
         while explicitly documenting the requirement. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Default behavior: all connections require HTTPS with TLS 1.2+.
             No exceptions are needed since Anthropic (api.anthropic.com)
             and OpenAI (api.openai.com) endpoints support modern TLS. -->
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Copyright -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2025-2026. All rights reserved.</string>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
</dict>
</plist>
